{
    "name": "raymond/quick-mmd",
    "description": "Parser Hook for SVG generation by Mermaid",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Raymond Wu",
            "email": "virus.warnning@gmail.com"
        }
    ],
    "require-dev": {
        "mediawiki/mediawiki-codesniffer": "^52.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "lint": "phpcs",
        "beautify": "phpcbf",
        "stan": "phpstan analyze"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
